{
  "name": "dsh-opencode-go-remaining",
  "version": "0.1.1",
  "description": "OpenCode Go 余量胶囊：在输入框工具行显示最紧张那一档的剩余百分比，点开查看滚动 5 小时 / 每周 / 每月三档余量、重置倒计时，并给 agent 提供 opencode_usage 工具。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "update.js",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "opencode",
    "opencode-go",
    "quota",
    "usage",
    "balance",
    "remaining"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baobao1994/dsh-opencode-go-remaining.git"
  },
  "homepage": "https://github.com/baobao1994/dsh-opencode-go-remaining#readme",
  "bugs": {
    "url": "https://github.com/baobao1994/dsh-opencode-go-remaining/issues"
  },
  "author": "baobao1994",
  "publishConfig": {
    "access": "public"
  }
}
